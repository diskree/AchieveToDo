{
	"schemaVersion": 1,
	"id": "${modId}",
	"version": "${modVersion}",
	"name": "${modName}",
	"description": "A mod that makes advancements a part of the gameplay.",
	"authors": [
		"${author}"
	],
	"contact": {
		"sources": "${repoUrl}"
	},
	"license": "CC-BY-4.0",
	"icon": "assets/achievetodo/icon.png",
	"environment": "*",
	"entrypoints": {
		"fabric-datagen": [
			"com.diskree.achievetodo.ability.generation.AbilitiesGenerator"
		],
		"main": [
			"com.diskree.achievetodo.AchieveToDoMod"
		],
		"client": [
			"com.diskree.achievetodo.client.AchieveToDoClient"
		]
	},
	"mixins": [
		"achievetodo.mixins.json"
	],
	"depends": {
		"java": ">=${minJavaVersion}",
		"minecraft": ">=${minMinecraftVersion}",
		"fabricloader": ">=${minLoaderVersion}",
		"fabric-api": "*"
	},
	"accessWidener": "achievetodo.accesswidener"
}
